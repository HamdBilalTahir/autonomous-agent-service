# Ollama Configuration
OLLAMA_URL=https://your-huggingface-space.hf.space
# Optional: Use Hugging Face Inference API directly
HF_API_KEY=hf_your_huggingface_token

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.0-pro

# AI Provider Configuration
# Options: ollama, gemini
AI_PROVIDER=ollama

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token
TARGET_GITHUB_OWNER=target_owner_username
TARGET_GITHUB_REPO=target_repo_name
AGENT_GITHUB_OWNER=agent_owner_username
AGENT_GITHUB_REPO=autonomous-agent-service

# Jira Configuration
JIRA_BASE_URL=your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=KUAILABS
